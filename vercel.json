{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 15, "includeFiles": "{server,shared}/**" }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?__path=:path*" }]
}
