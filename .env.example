# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://expy:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Optional, defaults to "expy"
MONGODB_DB="expy"

# Signs login tokens. 32+ random characters: openssl rand -base64 48
JWT_SECRET=""

# Setup key for first-time account creation, and the initial iOS Shortcuts key
# (you can regenerate the Shortcuts key later in Settings → Quick Logging).
# openssl rand -base64 24
API_KEY=""

# Optional: extra origins allowed to call the API from a browser (comma-separated).
# Same-domain requests are always allowed; Shortcuts send no Origin and are unaffected.
ALLOWED_ORIGINS=""
